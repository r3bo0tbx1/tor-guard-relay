{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges",
    ":disableDependencyDashboard",
    ":prHourlyLimit2"
  ],
  "labels": ["dependencies"],
  "commitMessagePrefix": "⬆️ build(deps):",
  "commitMessageAction": "update",
  "rebaseWhen": "behind-base-branch",
  "assignees": ["r3bo0tbx1"],
  "reviewers": ["r3bo0tbx1"],
  "enabledManagers": ["dockerfile", "github-actions", "gomod", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile(?:\\.edge)?$/"],
      "matchStrings": ["ARG LYREBIRD_REVISION=(?<currentDigest>[a-f0-9]{40})(?:\\r?\\n|$)"],
      "currentValueTemplate": "main",
      "depNameTemplate": "Lyrebird source",
      "packageNameTemplate": "https://gitlab.torproject.org/tpo/anti-censorship/pluggable-transports/lyrebird.git",
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "git"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^build/security-tools\\.json$/"],
      "matchStrings": ["\"govulncheck\":\\s*\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "golang.org/x/vuln",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^build/security-tools\\.json$/"],
      "matchStrings": ["\"renovate\":\\s*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^build/registry-tools\\.json$/"],
      "matchStrings": ["\"regctl\":\\s*\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "regclient/regclient",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.(?:md|sh|ya?ml|json)$/", "!CHANGELOG.md", "!docs/releases/**"],
      "matchStrings": ["(?:alpine:|Alpine(?: Linux)? )(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "alpine",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["org\\.opencontainers\\.image\\.base\\.name=\"docker\\.io/library/alpine:(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "alpine",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alpine"],
      "groupName": "🐳 Alpine Base Image",
      "groupSingleUpdates": true,
      "labels": ["dependencies", "alpine", "docker"],
      "schedule": ["at any time"],
      "prPriority": 1,
      "automerge": false,
      "allowedVersions": "/^3\\.(2[2-9]|[3-9][0-9])\\./",
      "description": "Update the stable base, OCI label and current examples together; preserve historical release records"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["!alpine"],
      "groupName": "🐳 Other Docker Images",
      "labels": ["dependencies", "docker"],
      "schedule": ["at any time"],
      "prPriority": 2,
      "automerge": false
    },
    {
      "matchManagers": ["gomod", "custom.regex"],
      "schedule": ["at any time"],
      "automerge": false,
      "prPriority": 5
    },
    {
      "description": "Batch routine validator upgrades while keeping an existing PR up to date",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["npm"],
      "matchPackageNames": ["renovate"],
      "schedule": ["* 0-3 * * 1"],
      "updateNotScheduled": true,
      "automerge": false
    },
    {
      "description": "Review received validator security alerts without the routine creation window",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["npm"],
      "matchPackageNames": ["renovate"],
      "matchJsonata": ["isVulnerabilityAlert = true"],
      "schedule": ["at any time"],
      "prCreation": "immediate",
      "minimumReleaseAge": "0 days",
      "automerge": false
    },
    {
      "matchPackageNames": ["regclient/regclient"],
      "prBodyNotes": ["Review the regctl release and update linux-amd64-sha256 from its verified release asset before merging. A stale checksum deliberately blocks installation and the registry rehearsal."],
      "automerge": false
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true,
      "automerge": false
    },
    {
      "matchDatasources": ["git-refs"],
      "groupName": "🧅 Lyrebird source pin",
      "labels": ["dependencies", "lyrebird"],
      "automerge": false,
      "prBodyNotes": ["Update both source and metadata pins in both Dockerfiles. Review upstream changes against the independently maintained Go lock and reassess the five routine Pion compatibility limits when Snowflake or its consumers change. Publish reviewed fixes through a captured main rebuild after all candidate gates pass; version bumps require a new release tag."]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "labels": ["dependencies", "github-actions"],
      "schedule": ["before 3am on monday"],
      "prPriority": 3,
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "GitHub Actions (patch/digest)",
      "labels": ["dependencies", "github-actions"],
      "schedule": ["before 3am on monday"],
      "automerge": true
    },
    {
      "description": "The pinned Renovate validator requires Node ^24.11.0; review both before a runtime major upgrade",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/validate.yml"],
      "matchDepNames": ["node"],
      "allowedVersions": "^24.11.0"
    },
    {
      "description": "Review the independently maintained Go graph as one update batch",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "🧅 Lyrebird Go dependencies",
      "groupSlug": "lyrebird-go-dependencies",
      "groupSingleUpdates": true,
      "automerge": false,
      "prBodyNotes": ["Review the combined Go graph against the pinned Lyrebird source and its documented Pion compatibility limits. If the readonly build requests go.mod updates, regenerate the lock in the actual pinned source, then run the full candidate matrix. Do not run go mod tidy in the lock-only directory."]
    },
    {
      "description": "Indirect major import-path migrations belong to the upstream consumers",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
        "description": "The reviewed Snowflake graph requires transport-v4 Pion interfaces; reassess with source or Snowflake updates",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/pion/webrtc/v4"],
      "allowedVersions": "<=4.2.20"
    },
    {
      "description": "Reviewed ICE interface limit for the current Snowflake graph",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/pion/ice/v4"],
      "allowedVersions": "<=4.4.2"
    },
    {
      "description": "Reviewed TURN interface limit for the current Snowflake graph",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/pion/turn/v5"],
      "allowedVersions": "<=5.1.0"
    },
    {
      "description": "Reviewed mDNS interface limit for the current Snowflake graph",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/pion/mdns/v2"],
      "allowedVersions": "<=2.2.0"
    },
    {
      "description": "Reviewed SRTP buffer interface limit for the current Snowflake graph",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/pion/srtp/v3"],
      "allowedVersions": "<=3.0.13"
    },
    {
      "description": "Security fixes cross routine compatibility limits for explicit review; OSV adds its fix range afterward",
      "matchManagers": ["gomod"],
      "matchJsonata": ["isVulnerabilityAlert = true"],
      "enabled": true,
      "allowedVersions": null,
      "groupName": null,
      "groupSlug": null,
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupSlug": null,
    "automerge": false,
    "prCreation": "immediate",
    "minimumReleaseAge": "0 days",
    "labels": ["security", "dependencies"],
    "assignees": ["r3bo0tbx1"],
    "schedule": ["at any time"]
  },
  "osvVulnerabilityAlerts": true,
  "timezone": "UTC",
  "prConcurrentLimit": 5,
  "description": "Propose reviewed Lyrebird source pins and independent Go/toolchain/base updates without a weekly wait. Security fixes receive priority; scheduled rebuilds use captured main source and require current candidate security gates."
}
