#!/bin/sh
set -eu
. "${RELAY_LIB:-/usr/local/lib/relay}/runtime.sh"
case "${1:-}" in '') ;; -h|--help) echo 'Usage: refresh (validate and signal the exact active Tor process)'; exit 0 ;; *) exit 2 ;; esac
die() { printf '%s\n' "$1" >&2; exit 1; }
inspect_process || die "$PROCESS_REASON"
config_valid || die 'Configuration invalid; no signal sent'
before=$START_TIME
ready() {
  mask=$(awk '/^SigCgt:/ {print $2}' "$PROC_ROOT/$TOR_PID/status")
  case "$mask" in ''|*[!A-Fa-f0-9]*) return 1 ;; esac
  [ "$((0x$mask & 1))" -eq 1 ]
}
attempt=0
while ! ready && [ "$attempt" -lt 50 ]; do
  [ "$(process_start "$TOR_PID")" = "$before" ] || die 'Process changed before reload'
  sleep 0.1; attempt=$((attempt+1))
done
ready || die 'Tor has not installed a SIGHUP handler; no signal sent'
[ "$(process_start "$TOR_PID")" = "$before" ] || die 'Process changed before reload'
kill -HUP "$TOR_PID"
sleep 1
[ "$(process_start "$TOR_PID")" = "$before" ] || die 'Tor exited or PID was reused after reload'
printf 'Configuration validated; SIGHUP delivered; PID %s and process start time preserved.\n' "$TOR_PID"