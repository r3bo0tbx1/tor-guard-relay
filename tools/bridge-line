#!/bin/sh
set -eu
. "${RELAY_LIB:-/usr/local/lib/relay}/runtime.sh"
inspect_process || true
inspect_config_paths
format=human; address=${TOR_BRIDGE_ADDRESS:-}; port=${TOR_OBFS4_PORT:-9002}
while [ "$#" -gt 0 ]; do
  case "$1" in
    --plain) format=plain; shift ;;
    --json) format=json; shift ;;
    --address) [ "$#" -ge 2 ] || exit 2; address=$2; shift 2 ;;
    --port) [ "$#" -ge 2 ] || exit 2; port=$2; shift 2 ;;
    -h|--help) echo 'Usage: bridge-line [--plain|--json] --address PUBLIC_ADDRESS [--port PORT]'; exit 0 ;;
    *) echo 'Unknown argument' >&2; exit 2 ;;
  esac
done
reason=ready; line=''
if ! grep -qi '^BridgeRelay[[:space:]]\+1' "$TOR_CONFIG" 2>/dev/null; then reason=not_bridge
elif [ ! -s "$TOR_DATA_DIR/pt_state/obfs4_bridgeline.txt" ] || [ ! -s "$TOR_DATA_DIR/fingerprint" ]; then reason=transport_pending
elif [ -z "$address" ]; then reason=address_required
else
  case "$address" in *[!A-Za-z0-9.:\[\]-]*|0.0.0.0|localhost|::) reason=invalid_address ;; esac
  case "$port" in ''|*[!0-9]*) reason=invalid_port ;; *) [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || reason=invalid_port ;; esac
  fingerprint=$(awk 'NR==1 {print $2}' "$TOR_DATA_DIR/fingerprint")
  printf '%s' "$fingerprint" | grep -qE '^[A-Fa-f0-9]{40}$' || reason=identity_pending
  template=$(grep -E '^(Bridge )?obfs4 ' "$TOR_DATA_DIR/pt_state/obfs4_bridgeline.txt" | head -n 1 || true)
  [ -n "$template" ] || reason=transport_pending
  if [ "$reason" = ready ]; then
    case "$address" in *:*) case "$address" in \[*\]) ;; *) address="[$address]" ;; esac ;; esac
    line=$(printf '%s\n' "$template" | sed "s/<IP ADDRESS>/$address/g;s/<IPADDRESS>/$address/g;s/<PORT>/$port/g;s/<FINGERPRINT>/$fingerprint/g")
    case "$line" in *'<'*|*'>'*) reason=transport_pending; line='' ;; esac
  fi
fi
if [ "$format" = json ]; then
  printf '{"reason":"%s","line":' "$reason"; json_string "$line"; printf '}\n'
elif [ "$reason" != ready ]; then
  printf 'Bridge line unavailable: %s\n' "$reason" >&2
elif [ "$format" = plain ]; then printf '%s\n' "$line"
else printf 'obfs4 bridge line\n%s\n\nShare privately with intended users.\n' "$line"; fi
[ "$reason" = ready ]
