#!/bin/sh
set -eu
. "${RELAY_LIB:-/usr/local/lib/relay}/runtime.sh"
case "${1:-}" in --json) exec "$(dirname "$0")/health" ;; -h|--help) echo 'Usage: status [--json]'; exit 0 ;; '') ;; *) exit 2 ;; esac
inspect_health
printf '\nTor Guard Relay · %s\n' "$BUILD_VERSION"
printf 'Process: %s (PID %s, uptime %s)\nReadiness: %s (%s)\n' "$LIVE" "$TOR_PID" "$UPTIME" "$READY" "$REASON"
printf 'Bootstrap: %s%% · ORPort: %s (Tor self-test)\n' "$BOOTSTRAP" "$REACHABLE"
printf 'Config: %s · valid: %s\nPath: %s\n' "$CONFIG_SOURCE" "$CONFIG_VALID" "$TOR_CONFIG"
printf 'Nickname: %s · mode: %s\nFingerprint: %s\nCurrent-run errors: %s\n\n' "$NICKNAME" "$RELAY_MODE" "$FINGERPRINT" "$ERRORS"
[ "$LIVE" = true ]